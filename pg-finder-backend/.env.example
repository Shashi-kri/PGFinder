# --- Server ---
PORT=3000
CORS_ORIGIN=*                      # comma-separated origins in prod, e.g. https://app.example.com

# --- PostgreSQL ---
DATABASE_URL=postgres://user:pass@localhost:5432/pgfinder
PGSSL=false                        # true for managed Postgres (Render/Supabase/RDS)
PG_POOL_MAX=10

# --- Firebase Admin (choose ONE) ---
# 1) Path to service-account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
# 2) Or inline JSON string:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
# CLOUDINARY_UPLOAD_PRESET=optional_preset_name
